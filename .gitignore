!/CLAUDE.md
!/preview.html
!/index.html
!/PROJECT_CONTEXT.md
!/references/
!/references/*
!/references/character-reference.jpg
!/winter-rink/
!/assets/
!/assets/*

# never commit
node_modules/
.env
.env.*
*.pem
*.key
*.zip